# Server
NODE_ENV=development
PORT=3001
JWT_SECRET=change-me-to-a-64-char-random-hex-string

# AI Providers
GROQ_API_KEY=gsk_...
GEMINI_API_KEY=AIza...
OPENROUTER_API_KEY=sk-or-...
NVIDIA_API_KEY=nvapi-...

# Daily request limits
GROQ_CHAT_DAILY_LIMIT=14400
GROQ_SUMMARY_DAILY_LIMIT=1000
GEMINI_DAILY_LIMIT=1500
OPENROUTER_DAILY_LIMIT=200
NVIDIA_DAILY_LIMIT=500

# Email (Resend)
RESEND_API_KEY=re_...
EMAIL_FROM=noreply@holop.dev
EMAIL_TO=you@example.com

# Data paths
DATA_DIR=/home/user/shoyu-chat/data

# Timezone for cron jobs
TZ=America/New_York
